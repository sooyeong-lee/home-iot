# =====================================================================
# Home IoT 로컬 개발 환경 변수 (t1-base)
#   cp .env.example .env   후 필요한 값만 바꿔서 사용
#   .env 와 secrets/ 는 git 에 올리지 않는다 (.gitignore)
# =====================================================================

# ---- t1-base (개발 VM) 접속 주소 ----
# 브라우저에서 t1-base 로 접속할 때 쓰는 IP·호스트 이름 (쉼표로 여러 개)
# Next.js 개발 서버(make web-dev)는 여기 적힌 주소에서 온 요청만 허용한다 (allowedDevOrigins)
# t1-base IP 나 이름이 바뀌면 여기만 고치고 make web-dev 를 다시 실행
DEV_HOSTS=10.10.31.20,t1-base

# ---- PostgreSQL ----
# 기본: docker compose 로 띄운 로컬 postgres
# t1-loc-db 를 직접 쓰려면 DB_HOST=10.10.31.10 으로 변경
DB_HOST=localhost
DB_PORT=5432
DB_NAME=homeiot
DB_USER=homeiot
DB_PASSWORD=homeiot-dev
DB_SCHEMA=dev

# ---- MQTT (Mosquitto) ----
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=homeiot
MQTT_PASSWORD=homeiot-dev

# ---- JWT (RS256) : scripts/gen-jwt-keys.sh 로 생성 ----
# 개인키: auth-service 가 토큰 발급(서명)에만 사용. 경로는 서비스 폴더(services/xxx) 기준
# 토큰 검증은 Gateway(로컬: tools/dev-gateway)에서만 한다 → 다른 서비스는 키가 필요 없음
JWT_PRIVATE_KEY_FILE=../../secrets/jwt-private.pem
JWT_ISSUER=homeiot-auth
JWT_AUDIENCE=homeiot
ACCESS_TOKEN_TTL_SEC=3600
REFRESH_TOKEN_TTL_SEC=1209600

# ---- 서비스 간 호출 ----
DEVICE_SERVICE_URL=http://localhost:3002

# ---- 동작 값 ----
COMMAND_TIMEOUT_MS=5000
OFFLINE_AFTER_SEC=20
SIM_INTERVAL_SEC=5
SIM_FLOOR_MOVE_MS=1500
LOG_LEVEL=info

# =====================================================================
# Jenkins 실행 값 (cp ci/jenkins/.env.example ci/jenkins/.env 후 수정)
# ci/jenkins/.env 는 git 에 올리지 않는다
# =====================================================================
# Jenkins 관리자 계정
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-jenkins
# 브라우저에서 접속할 Jenkins 주소 (t1-base IP 가 바뀌면 함께 수정)
JENKINS_URL=http://10.10.31.20:8090/
# GitHub 아이디와 PAT (권한: repo, write:packages)
GITHUB_USER=sooyeong-lee
GITHUB_TOKEN=ghp_change-me

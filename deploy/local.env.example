# =====================================================================
# 클러스터 Secret · DB 준비 값 (cp deploy/local.env.example deploy/local.env)
# scripts/k8s-secrets.sh(make gitops-secrets), make db-migrate 가 읽는다
# deploy/local.env 는 git 에 올리지 않는다
# =====================================================================
# t1-loc-db (PostgreSQL)
DB_IP=10.10.31.10
DB_NAME=homeiot
DB_USER=homeiot
DB_PASSWORD=change-me-db
# MQTT 계정 (클러스터 안 mosquitto 가 이 값으로 계정을 만든다)
MQTT_USERNAME=homeiot
MQTT_PASSWORD=change-me-mqtt
